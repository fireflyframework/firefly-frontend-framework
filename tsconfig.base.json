{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@firefly/design-system-contract": [
        "packages/design-system-contract/src/index.ts"
      ],
      "@firefly/utils": ["packages/utils/src/index.ts"],
      "@firefly/generators": ["packages/generators/src/index.ts"],
      "@firefly/config": ["packages/config/src/index.ts"],
      "@firefly/design-system": ["packages/design-system/src/index.ts"],
      "@firefly/schema-types": ["packages/schema-types/src/index.ts"],
      "@firefly/framework-core": ["packages/framework-core/src/index.ts"],
      "@firefly/testing-utils": ["packages/testing-utils/src/index.ts"],
      "@firefly/elements": ["packages/elements/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
