{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@fireflyframework/design-system-contract": [
        "./packages/design-system-contract/src/index.ts"
      ],
      "@fireflyframework/utils/array": [
        "./packages/utils/src/array/index.ts"
      ],
      "@fireflyframework/utils/object": [
        "./packages/utils/src/object/index.ts"
      ],
      "@fireflyframework/utils/string": [
        "./packages/utils/src/string/index.ts"
      ],
      "@fireflyframework/utils/type-guards": [
        "./packages/utils/src/type-guards/index.ts"
      ],
      "@fireflyframework/generators": [
        "./packages/generators/src/index.ts"
      ],
      "@fireflyframework/config": [
        "./packages/config/src/index.ts"
      ],
      "@fireflyframework/design-system": [
        "./packages/design-system/src/index.ts"
      ],
      "@fireflyframework/schema-types": [
        "./packages/schema-types/src/index.ts"
      ],
      "@fireflyframework/core": [
        "./packages/core/src/index.ts"
      ],
      "@fireflyframework/testing-utils": [
        "./packages/testing-utils/src/index.ts"
      ],
      "@fireflyframework/elements": [
        "./packages/elements/src/index.ts"
      ],
      "@fireflyframework/utils/formatting": [
        "./packages/utils/src/formatting/index.ts"
      ],
      "@fireflyframework/utils/json": [
        "./packages/utils/src/json/index.ts"
      ],
      "@fireflyframework/utils/storage": [
        "./packages/utils/src/storage/index.ts"
      ],
      "@fireflyframework/utils/user-agent": [
        "./packages/utils/src/user-agent/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
