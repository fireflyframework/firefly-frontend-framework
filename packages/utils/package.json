{
  "name": "@fireflyframework/utils",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fireflyframework/firefly-frontend-framework.git",
    "directory": "packages/utils"
  },
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    "./array": {
      "types": "./src/array/index.d.ts",
      "default": "./src/array/index.js"
    },
    "./object": {
      "types": "./src/object/index.d.ts",
      "default": "./src/object/index.js"
    },
    "./string": {
      "types": "./src/string/index.d.ts",
      "default": "./src/string/index.js"
    },
    "./type-guards": {
      "types": "./src/type-guards/index.d.ts",
      "default": "./src/type-guards/index.js"
    },
    "./formatting": {
      "types": "./src/formatting/index.d.ts",
      "default": "./src/formatting/index.js"
    },
    "./json": {
      "types": "./src/json/index.d.ts",
      "default": "./src/json/index.js"
    },
    "./version": {
      "types": "./src/version/index.d.ts",
      "default": "./src/version/index.js"
    },
    "./io": {
      "types": "./src/io/index.d.ts",
      "default": "./src/io/index.js"
    },
    "./transformations": {
      "types": "./src/transformations/index.d.ts",
      "default": "./src/transformations/index.js"
    },
    "./constants": {
      "types": "./src/constants/index.d.ts",
      "default": "./src/constants/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "vitest": "4.0.9",
    "@nx/vite": "22.6.5"
  }
}
